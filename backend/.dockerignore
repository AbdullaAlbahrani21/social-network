# Runtime state. The dev database and the uploads directory live beside the
# source, and both belong to the developer's machine, not the image: the
# container gets an empty volume and migrates into it on first start.
*.db
*.db-journal
*.db-wal
*.db-shm
uploads/

# Nothing in the build needs history or tooling config.
.git
.gitignore
.vscode

# Anything a local `go build` left behind. The image builds its own.
*.exe
server
