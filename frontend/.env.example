# Where the API lives, baked into the bundle at build time.
#
# Leave it unset for `npm run dev`: vite.config.js proxies /api and /ws to
# localhost:8080, and api.js falls back to that same origin.
#
# Set it to an empty string when the frontend is served behind a reverse
# proxy that also fronts the API -- the docker-compose setup does exactly
# that -- so requests and image URLs stay relative to the page's own origin.
VITE_API_BASE_URL=http://localhost:8080
